{
  "name": "foct-building-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "export:themes": "node scripts/export-theme-tokens.mjs",
    "build:apply-sql": "sh -c 'cat supabase/migrations/0000_platform_foundation.sql supabase/migrations/0001_theme_engine.sql supabase/seed.sql > supabase/APPLY_STAGE2.sql.tmp && (echo \"-- GENERATED one-paste apply — regenerate with npm run build:apply-sql\"; cat supabase/APPLY_STAGE2.sql.tmp) > supabase/APPLY_STAGE2.sql && rm supabase/APPLY_STAGE2.sql.tmp'",
    "build:apply-stage4": "sh -c '(echo \"-- GENERATED one-paste apply for Stage 4 (integrations) — regenerate with npm run build:apply-stage4\"; echo \"-- Prereqs: APPLY_STAGE2 + APPLY_STAGE3 already applied. Idempotent — safe to re-run.\"; echo \"-- Afterwards run supabase/tests/integrations_isolation_check.sql (expect 19 ok-notices).\"; cat supabase/migrations/0005_integrations_framework.sql) > supabase/APPLY_STAGE4_INTEGRATIONS.sql'",
    "check:supabase": "node scripts/check-supabase.mjs",
    "build:apply-everything": "sh scripts/build-apply-everything.sh",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "check:deps": "node scripts/check-deps.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:tokens && npm run check:contrast && npm run typecheck && npm run lint && npm run test:unit && npm run check:secrets && npm run check:deps && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@fontsource-variable/onest": "^5.2.11",
    "@fontsource-variable/roboto": "^5.2.10",
    "@fontsource-variable/roboto-mono": "^5.2.9",
    "@fontsource/barlow": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.4",
    "geist": "^1.7.2",
    "lucide-react": "^1.23.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
