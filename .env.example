# Supabase (Sydney) — project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server-side only (Inngest jobs, PDF worker — Stage 3+). NEVER exposed to the client.
# SUPABASE_SECRET_KEY=sb_secret_...

# Integrations framework (Stage 4). Server-side ONLY — never NEXT_PUBLIC_*.
# Needed by /api/integrations/* to reveal Vault secrets and write notification_log.
# SUPABASE_SECRET_KEY=sb_secret_...
# Flip the integrations GUI + test sends from the local demo store to Supabase:
# NEXT_PUBLIC_INTEGRATIONS_LIVE=1
