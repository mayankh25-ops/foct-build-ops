# Supabase (Sydney region project) — copy to .env.local and fill in.
# Values live in the Supabase dashboard: Project Settings → API.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never ship to the client.
# Bypasses RLS — use only in trusted server code (jobs, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
